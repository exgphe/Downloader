    "Keep this sheet open while Downloader reads the link. Downloads can continue in the background. You may need to reopen Downloader to finish processing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ هذه الورقة مفتوحة أثناء قراءة الرابط. يمكن متابعة التنزيل في الخلفية. قد يلزم فتح Downloader مجددًا لإكمال المعالجة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass dieses Fenster geöffnet, während Downloader den Link liest. Downloads können im Hintergrund fortgesetzt werden. Zum Abschluss musst du Downloader eventuell erneut öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén esta hoja abierta mientras Downloader lee el enlace. La descarga puede continuar en segundo plano. Es posible que tengas que volver a abrir Downloader para terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez cette feuille ouverte pendant la lecture du lien. Le téléchargement peut continuer en arrière-plan. Vous devrez peut-être rouvrir Downloader pour terminer le traitement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब तक Downloader लिंक पढ़ रहा है, यह शीट खुली रखें। डाउनलोड बैकग्राउंड में जारी रह सकता है। प्रक्रिया पूरी करने के लिए Downloader फिर से खोलना पड़ सकता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクの読み込み中はこのシートを開いたままにしてください。ダウンロードはバックグラウンドでも続行できます。処理を完了するには Downloader を開き直す必要がある場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloader가 링크를 읽는 동안 이 시트를 열어 두세요. 다운로드는 백그라운드에서 계속될 수 있습니다. 처리를 마치려면 Downloader를 다시 열어야 할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha esta folha aberta enquanto o Downloader lê o link. O download pode continuar em segundo plano. Talvez seja necessário reabrir o Downloader para concluir o processamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解析链接时，请保持此面板打开。下载可在后台继续，后续处理可能需要重新打开 Downloader。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讀取連結時，請保持此面板開啟。下載可在背景繼續，後續處理可能需要重新開啟 Downloader。"
          }
        }
      }
    },
