    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ الوسائط التي تنزّلها من Instagram وX في تطبيق الصور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere von Instagram und X geladene Medien in Fotos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save the Instagram and X media you download to Photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda en Fotos el contenido que descargues de Instagram y X."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez dans Photos les médias téléchargés depuis Instagram et X."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instagram और X से डाउनलोड किया गया मीडिया फ़ोटो में सहेजें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instagram や X からダウンロードしたメディアを写真に保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instagram과 X에서 다운로드한 미디어를 사진 앱에 저장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve no Fotos as mídias que você baixar do Instagram e do X."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将从 Instagram 和 X 下载的媒体保存到“照片”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將從 Instagram 和 X 下載的媒體儲存至「照片」。"
          }
        }
      }
    }
