        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइट से मीडिया नहीं मिला। यह अनुपलब्ध हो सकता है, लॉगिन चाहिए हो सकता है या API बदल गई हो सकती है।"
          }
