          }
        }
      }
    },
    "The site could not provide this media. It may be unavailable, require sign-in, or its API may have changed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر جلب الوسائط من الموقع. قد تكون غير متاحة أو تتطلب تسجيل الدخول أو ربما تغيّرت واجهة البرمجة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Website hat die Medien nicht bereitgestellt. Sie sind möglicherweise nicht verfügbar, erfordern eine Anmeldung oder die API hat sich geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sitio no ha proporcionado este contenido. Puede que no esté disponible, requiera iniciar sesión o haya cambiado la API."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le site n’a pas fourni ce média. Il est peut-être indisponible, nécessite une connexion ou son API a changé."
