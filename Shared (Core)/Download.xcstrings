        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक किया गया Instagram लॉगिन पढ़ा नहीं जा सका। Downloader एक्सटेंशन से फिर सिंक करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期した Instagram のログイン情報を読み込めません。Downloader 機能拡張から再度同期してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화된 Instagram 로그인 정보를 읽을 수 없습니다. Downloader 확장 프로그램에서 다시 동기화하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler a sessão sincronizada do Instagram. Sincronize novamente pela extensão Downloader."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
