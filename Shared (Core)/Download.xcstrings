    },
    "This video requires sign-in. Safari's login session is not automatically shared with the built-in video engine." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب الفيديو تسجيل الدخول. لا تُشارَك جلسة سفاري تلقائيًا مع محرّك الفيديو المدمج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
