        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게시물에는 미디어를 최대 20개까지 담을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma publicação pode conter até 20 mídias."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个帖子最多可包含 20 个媒体项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每則貼文最多可包含 20 個媒體項目。"
          }
        }
      }
    },
    "Allow Downloader to add photos in Settings > Privacy & Security > Photos, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Downloader بإضافة الصور من الإعدادات ← الخصوصية والأمن ← الصور، ثم أعِد المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Downloader unter „Einstellungen“ > „Datenschutz & Sicherheit“ > „Fotos“, Fotos hinzuzufügen. Versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Downloader añada fotos en Ajustes > Privacidad y seguridad > Fotos y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Réglages > Confidentialité et sécurité > Photos, autorisez Downloader à ajouter des photos, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्ज़ > गोपनीयता और सुरक्षा > फ़ोटो में Downloader को तस्वीरें जोड़ने की अनुमति दें, फिर कोशिश करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」＞「プライバシーとセキュリティ」＞「写真」で Downloader に写真の追加を許可し、再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 > 개인정보 보호 및 보안 > 사진에서 Downloader의 사진 추가를 허용한 후 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o Downloader adicione fotos em Ajustes > Privacidade e Segurança > Fotos e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”>“隐私与安全性”>“照片”中允许 Downloader 添加照片，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」>「隱私權與安全性」>「照片」中允許 Downloader 加入照片，再試一次。"
          }
        }
      }
