    "A post can contain at most 20 media items." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن يضم المنشور 20 عنصرًا على الأكثر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Beitrag kann höchstens 20 Medien enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una publicación admite hasta 20 elementos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une publication peut contenir jusqu’à 20 médias."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक पोस्ट में अधिकतम 20 मीडिया आइटम हो सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1件の投稿には最大20件のメディアを含められます。"
