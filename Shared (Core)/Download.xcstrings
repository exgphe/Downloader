    "The shared Instagram session could not be accessed. Rebuild and install Downloader with all its extensions, then sync again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى الجلسة المشتركة. أعِد بناء Downloader وتثبيته مع جميع الملحقات ثم أعِد المزامنة."
          }
        },
        "de" : {
          "stringUnit" : {
