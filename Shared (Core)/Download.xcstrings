    "Videos that change resolution or pixel format while playing cannot be converted yet." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن حاليًا تحويل فيديو تتغير دقته أو تنسيق بكسلاته أثناء التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos mit wechselnder Auflösung oder wechselndem Pixelformat können noch nicht konvertiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se pueden convertir vídeos que cambien de resolución o formato de píxel durante la reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conversion des vidéos dont la résolution ou le format de pixel change en cours de lecture n’est pas encore prise en charge."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लेबैक के दौरान रिज़ॉल्यूशन या पिक्सेल फ़ॉर्मैट बदलने वाले वीडियो अभी नहीं बदले जा सकते।"
