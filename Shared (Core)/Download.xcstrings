        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वीडियो के लिए लॉगिन चाहिए। Safari का लॉगिन बिल्ट-इन वीडियो इंजन के साथ अपने आप शेयर नहीं होता।"
