    "The synced Instagram session could not be read. Sync again from the Downloader extension." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة جلسة Instagram المتزامنة. أعِد المزامنة من ملحق Downloader."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die synchronisierte Instagram-Anmeldung konnte nicht gelesen werden. Synchronisiere sie erneut über die Downloader-Erweiterung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer la sesión de Instagram sincronizada. Vuelve a sincronizarla desde la extensión Downloader."
