{
  "sourceLanguage": "en",
  "strings": {
    "1. Open Safari and type instagram.com in the address bar. Sign in using the Safari profile you want to sync.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 手动打开 Safari，在地址栏输入 instagram.com，并在要同步的 Safari 配置文件中登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 手動開啟 Safari，在網址列輸入 instagram.com，並在要同步的 Safari 描述檔中登入。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ouvrez Safari et saisissez instagram.com dans la barre d’adresse. Connectez-vous avec le profil Safari à synchroniser."
          }
        }
      }
    },
    "1080p": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1080p"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1080p"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1080p"
          }
        }
      }
    },
    "2. Enable Downloader in Safari Extensions and allow it to access instagram.com.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 在 Safari 中启用 Downloader，并允许它访问 instagram.com。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 在 Safari 中啟用 Downloader，並允許它存取 instagram.com。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Activez Downloader dans les extensions Safari et autorisez l’accès à instagram.com."
          }
        }
      }
    },
    "2160p (4K)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2160p（4K）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2160p（4K）"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2160p (4K)"
          }
        }
      }
    },
    "3. Open the Downloader popup in Safari and tap Sync Instagram login.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 打开 Safari 的 Downloader 弹窗，点击「同步 Instagram 登录」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 開啟 Safari 的 Downloader 彈出視窗，點選「同步 Instagram 登入」。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Ouvrez la fenêtre Downloader dans Safari et touchez Synchroniser la connexion."
          }
        }
      }
    },
    "4. Return to Downloader or the share panel and retry the download.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 返回 Downloader 或分享面板，重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 返回 Downloader 或分享面板，重新下載。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Revenez dans Downloader ou le panneau de partage et réessayez le téléchargement."
          }
        }
      }
    },
    "Balanced": {
