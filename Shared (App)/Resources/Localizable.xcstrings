    "Changes apply to new downloads from the app, share menu, and Shortcuts. Downloads already started keep their settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسري التغييرات على التنزيلات الجديدة من التطبيق وقائمة المشاركة وتطبيق الاختصارات. تحتفظ التنزيلات الجارية بإعداداتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen gelten für neue Downloads aus der App, dem Teilen-Menü und der App „Kurzbefehle“. Laufende Downloads behalten ihre Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios se aplican a las nuevas descargas de la app, del menú Compartir y de Atajos. Las descargas en curso mantienen sus ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications s’appliquent aux nouveaux téléchargements depuis l’app, le menu de partage et Raccourcis. Les téléchargements déjà lancés conservent leurs réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
