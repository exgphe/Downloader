    },
    "Video bitrate: %lld Mbps": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频码率：%lld Mbps"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片位元率：%lld Mbps"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débit vidéo : %lld Mbit/s"
          }
        }
      }
    },
    "When enabled, AV1 video is converted after downloading. Other video codecs keep their original quality. Photos downloads may use a higher-resolution AV1 source.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，AV1 视频会在下载完成后转换。其他视频编码保持原画质。保存到照片时，也可使用更高分辨率的 AV1 源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，AV1 影片會在下載完成後轉換。其他影片編碼保留原畫質。儲存至照片時，也可使用更高解析度的 AV1 來源。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est activée, les vidéos AV1 sont converties après le téléchargement. Les autres codecs conservent leur qualité d’origine. Les téléchargements vers Photos peuvent utiliser une source AV1 de résolution supérieure."
          }
        }
      }
    },
    "You can also send a link from the system share menu.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi envoyer un lien depuis le menu de partage."
