    "Changes apply to new downloads from the app, share menu, and Shortcuts. Downloads already started keep their settings.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改应用于 App、分享菜单和快捷指令的新下载。已开始的下载保留原设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更套用至 App、分享選單和捷徑的新下載。已開始的下載保留原設定。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications s’appliquent aux nouveaux téléchargements depuis l’app, le menu de partage et Raccourcis. Les téléchargements déjà lancés conservent leurs réglages."
          }
        }
      }
    },
