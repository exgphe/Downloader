    "Best quality compatible with Photos." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أفضل جودة يدعمها تطبيق الصور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beste mit Fotos kompatible Qualität."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mejor calidad compatible con Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilleure qualité compatible avec Photos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोटो ऐप के अनुकूल सर्वोत्तम गुणवत्ता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真アプリに対応する最高画質。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 앱과 호환되는 최고 화질입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melhor qualidade compatível com o Fotos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择「照片」支持的最佳画质。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇「照片」支援的最佳畫質。"
          }
        }
      }
    },
    "Best source quality, including formats such as VP9 and AV1." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أفضل جودة للمصدر، بما في ذلك تنسيقات مثل VP9 وAV1."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beste Quellqualität, einschließlich Formaten wie VP9 und AV1."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mejor calidad de origen, incluidos formatos como VP9 y AV1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilleure qualité disponible, y compris VP9 et AV1."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VP9 और AV1 जैसे फ़ॉर्मैट सहित स्रोत की सर्वोत्तम गुणवत्ता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VP9 や AV1 などの形式を含む元のメディアの最高画質。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VP9 및 AV1 등의 포맷을 포함한 원본 최고 화질입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melhor qualidade da fonte, incluindo formatos como VP9 e AV1."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择来源支持的最佳画质，包括 VP9、AV1 等格式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇來源支援的最佳畫質，包括 VP9、AV1 等格式。"
          }
        }
      }
    },
